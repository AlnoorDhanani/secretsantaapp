# Twilio SMS Configuration (for local development only)
# Copy this file to .env and fill in your credentials

# Your Twilio Account SID (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid_here

# Your Twilio Auth Token (from https://console.twilio.com)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number in E.164 format (e.g., +15551234567)
TWILIO_PHONE_NUMBER=+15551234567

# Dry-run mode: if true, logs messages instead of sending (default: true)
# Set to "false" to actually send SMS messages
TWILIO_DRY_RUN=true
